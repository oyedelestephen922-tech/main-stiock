# ─────────────────────────────────────────────────────────────
# MainStocks Environment Variables — Robinhood Chain Mainnet
# ─────────────────────────────────────────────────────────────

# Market data
# "live" = real prices through Alpaca API proxy (/api/market/*).
# "demo" = high-fidelity mock stream with real market behaviors.
NEXT_PUBLIC_MARKET_DATA_PROVIDER=demo
NEXT_PUBLIC_MARKET_API_URL=

# Alpaca API keys (Optional for live US market candles)
# Free account at https://alpaca.markets -> API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Robinhood Chain Mainnet (Chain ID: 4663)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME="Robinhood Chain"
NEXT_PUBLIC_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
NEXT_PUBLIC_EXPLORER_URL="https://robinhoodchain.blockscout.com"
NEXT_PUBLIC_NATIVE_SYMBOL=ETH

# Wallets (Optional Reown / WalletConnect Project ID for mobile QR)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Smart contracts deployed on Robinhood Chain Mainnet
NEXT_PUBLIC_TRADE_ROUTER_ADDRESS=0x18f996cFE11b6ad7FFC7293D29823b4a34583778
NEXT_PUBLIC_VAULT_REGISTRY_ADDRESS=0x1f82849D4F82E99FCf707b6A80DA16D9EC84fE67
NEXT_PUBLIC_ORACLE_ADDRESS=0x682B61FA98AeD1F4Ef183789c2135dbB41C1d9fC
NEXT_PUBLIC_USDC_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Tradable Tokenized Stocks on Robinhood Chain Mainnet
NEXT_PUBLIC_TRADABLE_TICKERS=TSLA,NVDA,AAPL,PLTR,META,GOOGL,SPY

# Optional user balance / backend APIs
NEXT_PUBLIC_POSITIONS_API_URL=
NEXT_PUBLIC_ACTIVITY_API_URL=
NEXT_PUBLIC_VAULTS_API_URL=

# $MAIN token on Pons Launchpad (Optional)
NEXT_PUBLIC_MAIN_TOKEN_ADDRESS=
NEXT_PUBLIC_MAIN_TOKEN_CHAIN="Robinhood Chain"
NEXT_PUBLIC_MAIN_TOKEN_EXPLORER_URL="https://robinhoodchain.blockscout.com"
NEXT_PUBLIC_MAIN_TOKEN_PONS_URL=https://www.ponsfamily.com/launchpad
