# ─────────────────────────────────────────────────────────────
# MainStocks environment variables
# Copy to .env.local for local development, and add the same keys
# in Vercel → Project → Settings → Environment Variables.
# Every NEXT_PUBLIC_ value is visible in the browser. Never put a
# private key, seed phrase or secret API key in this file.
# ─────────────────────────────────────────────────────────────

# Market data
# "live"  = real prices through MainStocks' own server routes, powered by Alpaca.
#           Needs the two ALPACA_ keys below.
# "demo"  = built-in sample data, clearly labelled "Demo data" in the UI.
# "http"  = your own market data API at NEXT_PUBLIC_MARKET_API_URL
#           (see src/services/market/httpProvider.ts for the expected shapes).
NEXT_PUBLIC_MARKET_DATA_PROVIDER=live
NEXT_PUBLIC_MARKET_API_URL=

# Alpaca market data keys (free at alpaca.markets → sign up → API Keys).
# SERVER-ONLY: no NEXT_PUBLIC_ prefix, so they are never sent to visitors' browsers.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Free plan = real-time prices from the IEX exchange. Use "sip" only with a paid Alpaca data plan.
ALPACA_DATA_FEED=iex

# Optional user data sources (leave empty until you have them)
NEXT_PUBLIC_POSITIONS_API_URL=
NEXT_PUBLIC_ACTIVITY_API_URL=
NEXT_PUBLIC_VAULTS_API_URL=

# Network. Leave CHAIN_ID empty to use Ethereum mainnet + Sepolia.
# To use another EVM chain (for example Robinhood Chain), fill in all five.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CHAIN_NAME=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_NATIVE_SYMBOL=ETH

# Wallets. Browser wallets (MetaMask, Rabby, Coinbase extension…) work without this.
# Add a WalletConnect Cloud project ID to enable mobile wallets via QR code.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Smart contracts. Leave empty until they are deployed and verified.
# Trading and vault actions stay disabled in the UI while these are empty.
NEXT_PUBLIC_TRADE_ROUTER_ADDRESS=
NEXT_PUBLIC_VAULT_REGISTRY_ADDRESS=

# Comma-separated tickers your contracts can actually trade, e.g. AAPL,NVDA
# Anything not listed is shown as view-only.
NEXT_PUBLIC_TRADABLE_TICKERS=

# $MAIN token. Leave ADDRESS empty until the token is live on Pons —
# the site shows "Not launched" until then. Only ever paste the official address.
NEXT_PUBLIC_MAIN_TOKEN_ADDRESS=
NEXT_PUBLIC_MAIN_TOKEN_CHAIN=
NEXT_PUBLIC_MAIN_TOKEN_EXPLORER_URL=
NEXT_PUBLIC_MAIN_TOKEN_PONS_URL=https://www.ponsfamily.com/launchpad
